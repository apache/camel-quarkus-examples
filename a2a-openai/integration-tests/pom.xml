<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.camel.quarkus.examples</groupId>
        <artifactId>camel-quarkus-examples-a2a-openai</artifactId>
        <version>4.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>camel-quarkus-examples-a2a-openai-integration-tests</artifactId>

    <name>Camel Quarkus :: Examples :: A2A Support Ticket Triage with OpenAI :: Integration Tests</name>
    <description>Runs the orchestrator and the specialist agents together in one application and tests them end to end</description>

    <dependencies>
        <!-- The three applications under test -->
        <dependency>
            <groupId>org.apache.camel.quarkus.examples</groupId>
            <artifactId>camel-quarkus-examples-a2a-openai-orchestrator</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.quarkus.examples</groupId>
            <artifactId>camel-quarkus-examples-a2a-openai-billing-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.quarkus.examples</groupId>
            <artifactId>camel-quarkus-examples-a2a-openai-technical-agent</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <configuration>
                    <!-- This module assembles the three applications into one, so their application.properties are
                         merged with an undefined precedence for keys that several of them define. Build time settings
                         that must cover all three are therefore set explicitly here. -->
                    <systemProperties>
                        <quarkus.native.resources.includes>cards/*.json,prompts/*.txt</quarkus.native.resources.includes>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Re-enable the Quarkus build that the parent switches off on CI -->
            <id>ci</id>
            <activation>
                <property>
                    <name>env.CI</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>${quarkus.platform.group-id}</groupId>
                        <artifactId>quarkus-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build</id>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!-- Build this module natively even on CI, where the parent disables native builds -->
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>

</project>
